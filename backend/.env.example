# SkillGraph Backend Configuration

# Application Metadata
APP_NAME=SkillGraph API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

# CORS Allowed Origins (Comma-separated list of frontend addresses)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Server Host and Port Defaults
HOST=127.0.0.1
PORT=8000

# Database Configuration (SQLite default; can be overridden by environment)
DATABASE_URL=sqlite:///./skillgraph.db

# Authentication (Phase 7)
# Generate a cryptographically secure key: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE-ME-IN-PRODUCTION-use-a-cryptographically-secure-random-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ALGORITHM=HS256

# Frontend Application URL (used to generate reset-password links)
# Local: http://127.0.0.1:8000
# Production (Render): https://your-skillgraph.onrender.com
FRONTEND_URL=http://127.0.0.1:8000
RESET_TOKEN_EXPIRE_MINUTES=20

# =============================================================================
# Email Service Configuration (Choose Option A or Option B)
# =============================================================================

# Option A: Resend Transactional Email API (Recommended for Render & Cloud)
# Get a free API key at https://resend.com (free 3,000 emails/month, HTTPS port 443)
RESEND_API_KEY=

# Option B: Authenticated SMTP (e.g. Gmail App Password, AWS SES, Brevo, SendGrid)
# For Gmail: Use a 16-character App Password generated at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@skillgraph.ai
SMTP_USE_TLS=True
SMTP_SSL=False
