# SkillGraph Backend Configuration

# Application Metadata
APP_NAME=SkillGraph API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

# CORS Allowed Origins (Comma-separated list of local frontend addresses)
# Wildcards ("*") combined with credentials are intentionally avoided for security.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Server Host and Port Defaults
HOST=127.0.0.1
PORT=8000

# Database Configuration (SQLite default; can be overridden by environment)
DATABASE_URL=sqlite:///./skillgraph.db

# Authentication (Phase 7)
# IMPORTANT: Replace with a cryptographically secure random string in production.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE-ME-IN-PRODUCTION-use-a-cryptographically-secure-random-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ALGORITHM=HS256

